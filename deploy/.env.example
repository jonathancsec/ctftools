# Copy to deploy/.env and adjust before running Docker Compose.

# Flask
SECRET_KEY=replace-with-a-long-random-string

# Public deployment (docker-compose.prod.yml)
SITE_DOMAIN=forensics.example.com
# Secure session cookie; set to 1 behind HTTPS
COOKIE_SECURE=0

# Uploads and storage
MAX_UPLOAD_BYTES=33554432
MAX_ARTIFACT_BYTES=5242880
RETENTION_HOURS=24
JOB_STALE_HOURS=2
DATA_DIR=./data

# Job queue: inline (background thread, no Redis) or rq (Redis worker)
QUEUE_MODE=inline
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE=forensics

# Tool execution
TOOL_TIMEOUT=60
TOOL_OUTPUT_LIMIT=100000
MAX_STRING_LINES=500

# Abuse controls for a public or shared instance
UPLOAD_LIMIT_PER_HOUR=20
MAX_PENDING_JOBS=25
# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=0
